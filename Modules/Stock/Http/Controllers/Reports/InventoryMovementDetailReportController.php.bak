            '9' => 'إذن مخزن',
            '10' => 'منتج مجمع خارجي',
            '14' => 'إشعار مدين المشتريات',
            '101' => 'إذن مخزني يدوي داخلي',
            '102' => 'إذن مخزني يدوي خارجي',
            '103' => 'إذن مخزني فاتورة',
            '104' => 'إذن مخزني مرتجع مبيعات',
