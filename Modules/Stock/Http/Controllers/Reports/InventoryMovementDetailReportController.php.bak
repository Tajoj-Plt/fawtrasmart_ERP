    /**
     * الحصول على تسمية نوع المصدر
     */
    protected function getSourceTypeLabel($movement)
    {
        if (is_string($movement)) {
            return $movement;
        }

        if (is_array($movement) && isset($movement['permission_source'])) {
            return $movement['permission_source']['name'] ?? 'غير محدد';
        }

        if (is_array($movement) && isset($movement['type'])) {
            return $this->getMovementTypeLabel($movement['type']);
        }

        return 'غير محدد';
    }

    /**
     * جلب بيانات حركة المخزون - كمصفوفة (للعرض المباشر بدون JavaScript)
     * الآن تجلب البيانات الصحيحة من جداول صحيحة
     */
    private function getInventoryMovementDataArray(Request $request)
    {
        try {
            // جلب جميع الفلترات من الطلب
            $startDate = $request->input('start_date');
            $endDate = $request->input('end_date');
            $productId = $request->input('product');
            $categoryId = $request->input('category');
            $sourceType = $request->input('source_type');
            $brand = $request->input('brand');
            $warehouseId = $request->input('warehouse');

            // 1. جلب البيانات من InvoiceItem (الفواتير)
            $invoiceItemsQuery = InvoiceItem::with([
                'product',
                'storeHouse'
            ]);

            // فلترة حسب المنتج
            if ($productId) {
                $invoiceItemsQuery->where('product_id', $productId);
            }

            // فلترة حسب التصنيف
            if ($categoryId) {
                $invoiceItemsQuery->whereHas('product', function ($query) use ($categoryId) {
                    $query->where('category_id', $categoryId);
                });
            }

            // فلترة حسب المصدر
            if ($sourceType) {
                $invoiceItemsQuery->where('type', $sourceType);
            }

            // فلترة حسب العلامة التجارية
            if ($brand) {
                $invoiceItemsQuery->whereHas('product', function ($query) use ($brand) {
                    $query->where('brand', $brand);
                });
            }

            // فلترة حسب المستودع
            if ($warehouseId) {
                $invoiceItemsQuery->where('store_house_id', $warehouseId);
            }

            // فلترة حسب الفترة الزمنية
            if ($startDate && $endDate) {
                $invoiceItemsQuery->whereBetween('created_at', [
                    Carbon::parse($startDate)->startOfDay(),
                    Carbon::parse($endDate)->endOfDay()
                ]);
            } elseif ($startDate) {
                $invoiceItemsQuery->where('created_at', '>=', Carbon::parse($startDate)->startOfDay());
            } elseif ($endDate) {
                $invoiceItemsQuery->where('created_at', '<=', Carbon::parse($endDate)->endOfDay());
            }

            // 2. جلب البيانات من WarehousePermitsProducts (الأذونات)
            $permitsQuery = WarehousePermitsProducts::with([
                'product',
                'warehousePermit.storeHouse',
                'warehousePermit.fromStoreHouse',
                'warehousePermit.toStoreHouse',
                'warehousePermit.permissionSource'
            ]);

            // تطبيق نفس الفلترات على الأذونات
            if ($productId) {
                $permitsQuery->where('product_id', $productId);
            }

            if ($categoryId) {
                $permitsQuery->whereHas('product', function ($query) use ($categoryId) {
                    $query->where('category_id', $categoryId);
                });
            }

            if ($brand) {
                $permitsQuery->whereHas('product', function ($query) use ($brand) {
                    $query->where('brand', $brand);
                });
            }

            if ($startDate && $endDate) {
                $permitsQuery->whereBetween('created_at', [
                    Carbon::parse($startDate)->startOfDay(),
                    Carbon::parse($endDate)->endOfDay()
                ]);
            } elseif ($startDate) {
                $permitsQuery->where('created_at', '>=', Carbon::parse($startDate)->startOfDay());
            } elseif ($endDate) {
                $permitsQuery->where('created_at', '<=', Carbon::parse($endDate)->endOfDay());
            }

            // دمج البيانات من المصدرين
            $allMovements = [];

            // إضافة بيانات الفواتير
            foreach ($invoiceItemsQuery->get() as $item) {
                $allMovements[] = [
                    'id' => 'invoice_' . $item->id,
                    'created_at' => $item->created_at,
                    'type' => $this->getMovementTypeLabel($item->type),
                    'source' => 'فاتورة',
                    'source_type' => $this->getMovementTypeLabel($item->type),
                    'product_name' => $item->product ? $item->product->name : 'منتج غير محدد',
                    'product_id' => $item->product_id,
                    'quantity' => $item->quantity,
                    'unit_price' => $item->unit_price,
                    'purchase_price' => $item->purchase_price,
                    'total' => $item->total,
                    'store_house' => $item->storeHouse ? $item->storeHouse->name : 'مستودع غير محدد',
                    'store_house_id' => $item->store_house_id,
                ];
            }

            // إضافة بيانات الأذونات
            foreach ($permitsQuery->get() as $permit) {
                $warehouseName = 'غير محدد';
                if ($permit->warehousePermit && $permit->warehousePermit->storeHouse) {
                    $warehouseName = $permit->warehousePermit->storeHouse->name;
                }

                $sourceLabel = 'أذن مخزني';
                if ($permit->warehousePermit && $permit->warehousePermit->permissionSource) {
                    $sourceLabel = $permit->warehousePermit->permissionSource->name;
                }

                $allMovements[] = [
                    'id' => 'permit_' . $permit->id,
                    'created_at' => $permit->created_at,
                    'type' => 'أذن مخزني',
                    'source' => 'أذن مخزنية',
                    'source_type' => $sourceLabel,
                    'product_name' => $permit->product ? $permit->product->name : 'منتج غير محدد',
                    'product_id' => $permit->product_id,
                    'quantity' => $permit->quantity,
                    'unit_price' => $permit->unit_price,
                    'purchase_price' => $permit->unit_price,
                    'total' => $permit->quantity * $permit->unit_price,
                    'store_house' => $warehouseName,
                    'store_house_id' => $permit->warehousePermit ? $permit->warehousePermit->store_houses_id : null,
                ];
            }

            // ترتيب البيانات حسب التاريخ (الأحدث أولاً)
            usort($allMovements, function ($a, $b) {
                return strtotime($b['created_at']) - strtotime($a['created_at']);
            });

            // تجميع البيانات حسب المنتج
            $groupedMovements = [];
            $totalStats = [
                'total_products' => 0,
                'total_in' => 0,
                'total_out' => 0,
                'total_in_value' => 0,
                'total_out_value' => 0,
                'net_movement' => 0,
                'total_stock_value' => 0,
                'total_movements' => count($allMovements)
            ];

            $processedMovements = [];
            $productIds = [];

            foreach ($allMovements as $movement) {
                $productName = $movement['product_name'];
                $productIds[] = $movement['product_id'];

                if (!isset($groupedMovements[$productName])) {
                    $groupedMovements[$productName] = [];
                }

                // الحصول على الرصيد الحالي من ProductDetails
                $currentStock = $this->getCurrentStockFromProductDetails(
                    $movement['product_id'],
                    $movement['store_house_id']
                );

                // الحساب التفصيلي للحركة
                $stockAfter = $currentStock;
                $quantity = $movement['quantity'] ?? 0;

                // تحديد حالة الحركة (داخل أم خارج)
                if ($movement['source'] === 'أذن مخزنية') {
                    // للأذونات المخزنية نحتاج للتحقق من نوع الأذن
                    if (strpos($movement['source_type'], 'يدوي') !== false ||
                        strpos($movement['source_type'], 'شراء') !== false ||
                        strpos($movement['source_type'], 'تحويل') !== false) {
                        $stockAfter = $currentStock + $quantity;
                    } else {
                        $stockAfter = $currentStock - $quantity;
                    }
                } else {
                    // للفواتير: المبيعات تكون خروج، الشراء يكون دخول
                    if (strpos($movement['type'], 'شراء') !== false ||
                        strpos($movement['type'], 'مرتجع') !== false) {
                        $stockAfter = $currentStock + $quantity;
                    } else {
                        $stockAfter = $currentStock - $quantity;
                    }
                }

                $processedMovements[] = array_merge($movement, [
                    'stock_after' => max(0, $stockAfter),
                    'product_id' => $movement['product_id']
                ]);

                // تحديث الإحصائيات
                if ($quantity > 0) {
                    $totalStats['total_in'] += $quantity;
                    $totalStats['total_in_value'] += $movement['total'];
                } else {
                    $totalStats['total_out'] += abs($quantity);
                    $totalStats['total_out_value'] += abs($movement['total']);
                }

                $groupedMovements[$productName][] = array_merge($movement, [
                    'stock_after' => max(0, $stockAfter)
                ]);
            }

            // حساب الإحصائيات النهائية
            $totalStats['total_products'] = count(array_unique($productIds));
            $totalStats['net_movement'] = $totalStats['total_in'] - $totalStats['total_out'];
            $totalStats['total_stock_value'] = $this->calculateTotalStockValue($productIds, $warehouseId);

            return [
                'success' => true,
                'grouped_movements' => $groupedMovements,
                'totals' => $totalStats,
                'products_count' => $totalStats['total_products'],
            ];

        } catch (\Exception $e) {
            Log::error('خطأ في تحميل بيانات حركة المخزون: ' . $e->getMessage());
            Log::error($e->getTraceAsString());

            return [
                'success' => false,
                'grouped_movements' => [],
                'totals' => [
                    'total_products' => 0,
                    'total_in' => 0,
                    'total_out' => 0,
                    'total_in_value' => 0,
                    'total_out_value' => 0,
                    'net_movement' => 0,
                    'total_stock_value' => 0,
                    'total_movements' => 0
                ],
            ];
        }
    }

    /**
     * جلب بيانات حركة المخزون
     */
    protected function getInventoryMovementData(Request $request)
    {
        try {
            // جلب جميع الفلترات من الطلب
            $startDate = $request->input('start_date');
            $endDate = $request->input('end_date');
            $productId = $request->input('product');
            $categoryId = $request->input('category');
            $sourceType = $request->input('source_type');
            $brand = $request->input('brand');
            $warehouseId = $request->input('warehouse');
            $page = $request->input('page', 1);
            $perPage = 50;

            // 1. جلب البيانات من InvoiceItem (الفواتير)
            $invoiceItemsQuery = InvoiceItem::with([
                'product',
                'storeHouse'
            ]);

            // فلترة حسب المنتج
            if ($productId) {
                $invoiceItemsQuery->where('product_id', $productId);
            }

            // فلترة حسب التصنيف
            if ($categoryId) {
                $invoiceItemsQuery->whereHas('product', function ($query) use ($categoryId) {
                    $query->where('category_id', $categoryId);
                });
            }

            // فلترة حسب المصدر
            if ($sourceType) {
                $invoiceItemsQuery->where('type', $sourceType);
            }

            // فلترة حسب العلامة التجارية
            if ($brand) {
                $invoiceItemsQuery->whereHas('product', function ($query) use ($brand) {
                    $query->where('brand', $brand);
                });
            }

            // فلترة حسب المستودع
            if ($warehouseId) {
                $invoiceItemsQuery->where('store_house_id', $warehouseId);
            }

            // فلترة حسب الفترة الزمنية
            if ($startDate && $endDate) {
                $invoiceItemsQuery->whereBetween('created_at', [
                    Carbon::parse($startDate)->startOfDay(),
                    Carbon::parse($endDate)->endOfDay()
                ]);
            } elseif ($startDate) {
                $invoiceItemsQuery->where('created_at', '>=', Carbon::parse($startDate)->startOfDay());
            } elseif ($endDate) {
                $invoiceItemsQuery->where('created_at', '<=', Carbon::parse($endDate)->endOfDay());
            }

            // 2. جلب البيانات من WarehousePermitsProducts (الأذونات)
            $permitsQuery = WarehousePermitsProducts::with([
                'product',
                'warehousePermit.storeHouse',
                'warehousePermit.fromStoreHouse',
                'warehousePermit.toStoreHouse',
                'warehousePermit.permissionSource'
            ]);

            // تطبيق نفس الفلترات على الأذونات
            if ($productId) {
                $permitsQuery->where('product_id', $productId);
            }

            if ($categoryId) {
                $permitsQuery->whereHas('product', function ($query) use ($categoryId) {
                    $query->where('category_id', $categoryId);
                });
            }

            if ($brand) {
                $permitsQuery->whereHas('product', function ($query) use ($brand) {
                    $query->where('brand', $brand);
                });
            }

            if ($startDate && $endDate) {
                $permitsQuery->whereBetween('created_at', [
                    Carbon::parse($startDate)->startOfDay(),
                    Carbon::parse($endDate)->endOfDay()
                ]);
            } elseif ($startDate) {
                $permitsQuery->where('created_at', '>=', Carbon::parse($startDate)->startOfDay());
            } elseif ($endDate) {
                $permitsQuery->where('created_at', '<=', Carbon::parse($endDate)->endOfDay());
            }

            // دمج البيانات من المصدرين
            $allMovements = [];

            // إضافة بيانات الفواتير
            foreach ($invoiceItemsQuery->get() as $item) {
                $allMovements[] = [
                    'id' => 'invoice_' . $item->id,
                    'created_at' => $item->created_at,
                    'type' => $this->getMovementTypeLabel($item->type),
                    'source' => 'فاتورة',
                    'source_type' => $this->getMovementTypeLabel($item->type),
                    'product_name' => $item->product ? $item->product->name : 'منتج غير محدد',
                    'product_id' => $item->product_id,
                    'quantity' => $item->quantity,
                    'unit_price' => $item->unit_price,
                    'purchase_price' => $item->purchase_price,
                    'total' => $item->total,
                    'store_house' => $item->storeHouse ? $item->storeHouse->name : 'مستودع غير محدد',
                    'store_house_id' => $item->store_house_id,
                ];
            }

            // إضافة بيانات الأذونات
            foreach ($permitsQuery->get() as $permit) {
                $warehouseName = 'غير محدد';
                if ($permit->warehousePermit && $permit->warehousePermit->storeHouse) {
                    $warehouseName = $permit->warehousePermit->storeHouse->name;
                }

                $sourceLabel = 'أذن مخزني';
                if ($permit->warehousePermit && $permit->warehousePermit->permissionSource) {
                    $sourceLabel = $permit->warehousePermit->permissionSource->name;
                }

                $allMovements[] = [
                    'id' => 'permit_' . $permit->id,
                    'created_at' => $permit->created_at,
                    'type' => 'أذن مخزني',
                    'source' => 'أذن مخزنية',
                    'source_type' => $sourceLabel,
                    'product_name' => $permit->product ? $permit->product->name : 'منتج غير محدد',
                    'product_id' => $permit->product_id,
                    'quantity' => $permit->quantity,
                    'unit_price' => $permit->unit_price,
                    'purchase_price' => $permit->unit_price,
                    'total' => $permit->quantity * $permit->unit_price,
                    'store_house' => $warehouseName,
                    'store_house_id' => $permit->warehousePermit ? $permit->warehousePermit->store_houses_id : null,
                ];
            }

            // ترتيب البيانات حسب التاريخ (الأحدث أولاً)
            usort($allMovements, function ($a, $b) {
                return strtotime($b['created_at']) - strtotime($a['created_at']);
            });

            // تجميع البيانات حسب المنتج
            $groupedMovements = [];
            $totalStats = [
                'total_products' => 0,
                'total_in' => 0,
                'total_out' => 0,
                'total_in_value' => 0,
                'total_out_value' => 0,
                'net_movement' => 0,
                'total_stock_value' => 0,
                'total_movements' => count($allMovements)
            ];

            $processedMovements = [];
            $productIds = [];

            foreach ($allMovements as $movement) {
                $productName = $movement['product_name'];
                $productIds[] = $movement['product_id'];

                if (!isset($groupedMovements[$productName])) {
                    $groupedMovements[$productName] = [];
                }

                // الحصول على الرصيد الحالي من ProductDetails
                $currentStock = $this->getCurrentStockFromProductDetails(
                    $movement['product_id'],
                    $movement['store_house_id']
                );

                // الحساب التفصيلي للحركة
                $stockAfter = $currentStock;
                $quantity = $movement['quantity'] ?? 0;

                // تحديد حالة الحركة (داخل أم خارج)
                if ($movement['source'] === 'أذن مخزنية') {
                    // للأذونات المخزنية نحتاج للتحقق من نوع الأذن
                    if (strpos($movement['source_type'], 'يدوي') !== false ||
                        strpos($movement['source_type'], 'شراء') !== false ||
                        strpos($movement['source_type'], 'تحويل') !== false) {
                        $stockAfter = $currentStock + $quantity;
                    } else {
                        $stockAfter = $currentStock - $quantity;
                    }
                } else {
                    // للفواتير: المبيعات تكون خروج، الشراء يكون دخول
                    if (strpos($movement['type'], 'شراء') !== false ||
                        strpos($movement['type'], 'مرتجع') !== false) {
                        $stockAfter = $currentStock + $quantity;
                    } else {
                        $stockAfter = $currentStock - $quantity;
                    }
                }

                $processedMovements[] = array_merge($movement, [
                    'stock_after' => max(0, $stockAfter),
                    'product_id' => $movement['product_id']
                ]);

                // تحديث الإحصائيات
                if ($quantity > 0) {
                    $totalStats['total_in'] += $quantity;
                    $totalStats['total_in_value'] += $movement['total'];
                } else {
                    $totalStats['total_out'] += abs($quantity);
                    $totalStats['total_out_value'] += abs($movement['total']);
                }

                $groupedMovements[$productName][] = array_merge($movement, [
                    'stock_after' => max(0, $stockAfter)
                ]);
            }

            // حساب الإحصائيات النهائية
            $totalStats['total_products'] = count(array_unique($productIds));
            $totalStats['net_movement'] = $totalStats['total_in'] - $totalStats['total_out'];
            $totalStats['total_stock_value'] = $this->calculateTotalStockValue($productIds, $warehouseId);

            $chartData = $this->prepareChartDataMovement($processedMovements, $request);

            return response()->json([
                'success' => true,
                'grouped_movements' => $groupedMovements,
                'totals' => $totalStats,
                'products_count' => $totalStats['total_products'],
                'chart_data' => $chartData,
                'pagination' => [
                    'total' => count($allMovements),
                    'per_page' => $perPage,
                    'current_page' => $page,
                    'last_page' => ceil(count($allMovements) / $perPage),
                ]
            ]);

        } catch (\Exception $e) {
            Log::error('خطأ في تحميل بيانات حركة المخزون: ' . $e->getMessage());
            Log::error($e->getTraceAsString());

            return response()->json([
                'success' => false,
                'message' => 'حدث خطأ في تحميل البيانات',
                'error' => $e->getMessage()
            ], 500);
        }
    }
}
