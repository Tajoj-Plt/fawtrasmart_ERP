// دالة للحصول على شارة نوع المهمة
function getTaskTypeBadge(type) {
    const types = {
        'component': { name: 'Component', class: 'primary' },
        'epic': { name: 'Epic', class: 'info' },
        'user_story': { name: 'User Story', class: 'success' },
        'sub_task': { name: 'Sub Task', class: 'warning' },
        'bug': { name: 'Bug', class: 'danger' }
    };
    
    const taskType = types[type] || { name: type, class: 'secondary' };
    return `<span class="badge badge-${taskType.class}">${taskType.name}</span>`;
}

// دالة لتعديل المهمة حسب النوع
function editTaskByType(id, type) {
    const typeMap = {
        'component': 'Component',
        'epic': 'Epic',
        'user_story': 'Story',
        'sub_task': 'SubTask',
        'bug': 'Bug'
    };
    
    const functionName = 'edit' + (typeMap[type] || 'Task');
    if (typeof window[functionName] === 'function') {
        window[functionName](id);
    } else {
        console.error('Function not found:', functionName);
    }
}

// دالة لحذف المهمة حسب النوع
function deleteTaskByType(id, type) {
    const typeMap = {
        'component': 'Component',
        'epic': 'Epic',
        'user_story': 'Story',
        'sub_task': 'SubTask',
        'bug': 'Bug'
    };
    
    const functionName = 'delete' + (typeMap[type] || 'Task');
    if (typeof window[functionName] === 'function') {
        window[functionName](id);
    } else {
        console.error('Function not found:', functionName);
    }
}

// دوال مساعدة
function getSprintStatusBadge(status) {
    const badges = {
        planned: '<span class="badge badge-secondary">مخطط</span>',
        active: '<span class="badge badge-success">نشط</span>',
        completed: '<span class="badge badge-primary">مكتمل</span>',
        cancelled: '<span class="badge badge-danger">ملغي</span>'
    };
    return badges[status] || '';
}

function getSprintHeaderClass(status) {
    const classes = {
        planned: 'bg-info text-white',
        active: 'bg-success text-white',
        completed: 'bg-primary text-white',
        cancelled: 'bg-danger text-white'
    };
    return classes[status] || 'bg-secondary text-white';
}

function formatDate(dateString) {
    if (!dateString) return '';
    const date = new Date(dateString);
    return date.toLocaleDateString('ar-SA');
}

function capitalizeFirst(str) {
    const map = {
        'component': 'Component',
        'epic': 'Epic',
        'user_story': 'Story',
        'sub_task': 'SubTask',
        'bug': 'Bug'
    };
    return map[str] || str;
}

