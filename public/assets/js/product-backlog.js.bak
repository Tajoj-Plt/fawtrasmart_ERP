// تحديث دالة loadTabContent لدعم تبويبة Backlog الجديدة
const originalLoadTabContent = loadTabContent;
loadTabContent = function(tab) {
    if (tab === 'backlog-overview') {
        loadBacklogWithSprints();
    } else {
        originalLoadTabContent(tab);
    }
};