            type: 'DELETE',
            data: { _token: $('meta[name="csrf-token"]').attr('content') },
            success: (r) => { if (r.success) { showToast('success', r.message); loadBugs(); loadEpics(); }},
            error: () => showToast('error', 'حدث خطأ')
        });
    });
}

// ==================== Utility Functions ====================

function showFormErrors(container, errors) {
    let html = '<ul class="mb-0">';
    $.each(errors, (key, value) => html += `<li>${value[0]}</li>`);
    html += '</ul>';
    $(container).html(html).show();
}

function confirmDelete(type, callback) {
    Swal.fire({
        title: 'هل أنت متأكد؟',
        text: `سيتم حذف هذا ${type} وكل ما يتعلق به!`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'نعم، احذف!',
        cancelButtonText: 'إلغاء'
    }).then((result) => {
        if (result.isConfirmed) callback();
    });
}

function showToast(type, message) {
    const icons = { success: 'success', error: 'error', warning: 'warning', info: 'info' };
    Swal.fire({
        icon: icons[type] || 'info',
        title: message,
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: type === 'error' ? 4000 : 2500,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer);
            toast.addEventListener('mouseleave', Swal.resumeTimer);
        }
    });
}

// Add a new function to assign sprint to any task with hierarchical inheritance
function assignSprintToTask(taskId, taskType) {
    // Create a simple prompt for sprint selection
    const sprintOptions = $('#componentFilterSprint').html() || '';
    const sprintSelect = `
        <div class="form-group">
            <label>اختر Sprint:</label>
            <select id="sprintSelect" class="form-control" style="width: 100%;">
                <option value="">بدون Sprint - Backlog</option>
                ${sprintOptions}
            </select>
            <button type="button" class="btn btn-sm btn-outline-primary mt-2" id="createNewSprintBtn">
                <i class="feather icon-plus"></i> إنشاء Sprint جديد
            </button>
        </div>
        <div class="form-group" id="newSprintForm" style="display: none; margin-top: 15px;">
            <label>اسم Sprint الجديد:</label>
            <input type="text" id="newSprintName" class="form-control" placeholder="أدخل اسم Sprint">
            <label class="mt-2">الهدف:</label>
            <textarea id="newSprintGoal" class="form-control" placeholder="أدخل هدف Sprint"></textarea>
            <label class="mt-2">تاريخ البدء:</label>
            <input type="date" id="newSprintStartDate" class="form-control">
            <label class="mt-2">تاريخ الانتهاء:</label>
            <input type="date" id="newSprintEndDate" class="form-control">
        </div>
        <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" id="applyToChildren" checked>
            <label class="form-check-label" for="applyToChildren">
                تطبيق على جميع العناصر الفرعية
            </label>
        </div>
    `;

    Swal.fire({
        title: 'تعيين Sprint',
        html: sprintSelect,
        showCancelButton: true,
        confirmButtonText: 'حفظ',
        cancelButtonText: 'إلغاء',
        didOpen: () => {
            // Load task current sprint if exists
            $.get('/tasks/' + taskId, (response) => {
                if (response.success && response.task.sprint_id) {
                    $('#sprintSelect').val(response.task.sprint_id);
                }
            });

            // Toggle new sprint form
            $('#createNewSprintBtn').on('click', function() {
                $('#newSprintForm').toggle();
                if ($('#newSprintForm').is(':visible')) {
                    $(this).html('<i class="feather icon-x"></i> إلغاء إنشاء Sprint');
                } else {
                    $(this).html('<i class="feather icon-plus"></i> إنشاء Sprint جديد');
                    // Clear form fields
                    $('#newSprintName').val('');
                    $('#newSprintGoal').val('');
                    $('#newSprintStartDate').val('');
                    $('#newSprintEndDate').val('');
                }
            });
        },
        preConfirm: () => {
            // Check if creating new sprint
            if ($('#newSprintForm').is(':visible')) {
                const name = $('#newSprintName').val();
                const goal = $('#newSprintGoal').val();
                const startDate = $('#newSprintStartDate').val();
                const endDate = $('#newSprintEndDate').val();

                if (!name) {
                    Swal.showValidationMessage('يرجى إدخال اسم Sprint');
                    return false;
                }

                return {
                    createNew: true,
                    name: name,
                    goal: goal,
                    start_date: startDate,
                    end_date: endDate,
                    applyToChildren: $('#applyToChildren').is(':checked')
                };
            } else {
                const sprintId = $('#sprintSelect').val();
                const applyToChildren = $('#applyToChildren').is(':checked');
                return {
                    createNew: false,
                    sprintId: sprintId,
                    applyToChildren: applyToChildren
                };
            }
        }
    }).then((result) => {
        if (result.isConfirmed) {
            if (result.value.createNew) {
                // Create new sprint and assign it
                createAndAssignSprint(
                    taskId,
                    result.value.name,
                    result.value.goal,
                    result.value.start_date,
                    result.value.end_date,
                    result.value.applyToChildren
                );
            } else {
                // Update the task with the selected sprint
                const formData = new FormData();
                formData.append('_token', $('meta[name="csrf-token"]').attr('content'));
                if (result.value.sprintId) {
                    formData.append('sprint_id', result.value.sprintId);
                }

                if (result.value.applyToChildren) {
                    // Use route helper for updating children sprint - POST method
                    $.ajax({
                        url: route('tasks.update-children-sprint', { taskId: taskId }),
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        success: (response) => {
                            if (response.success) {
                                showToast('success', 'تم تحديث Sprint لجميع العناصر الفرعية');
                                // Reload the current tab
                                const activeTab = $('.tab-pane.active').attr('id');
                                loadTabContent(activeTab);
                            } else {
                                showToast('error', response.message || 'حدث خطأ أثناء تحديث العناصر الفرعية');
                                // Still reload the current tab
                                const activeTab = $('.tab-pane.active').attr('id');
                                loadTabContent(activeTab);
                            }
                        },
                        error: (xhr) => {
                            showToast('error', 'حدث خطأ أثناء تحديث العناصر الفرعية: ' + (xhr.responseJSON?.message || 'خطأ غير معروف'));
                            // Still reload the current tab
                            const activeTab = $('.tab-pane.active').attr('id');
                            loadTabContent(activeTab);
                        }
                    });
                } else {
                    // Update only the current task - PUT method
                    const putData = new FormData();
                    putData.append('_token', $('meta[name="csrf-token"]').attr('content'));
                    putData.append('_method', 'PUT');
                    if (result.value.sprintId) {
                        putData.append('sprint_id', result.value.sprintId);
                    }

                    $.ajax({
                        url: '/tasks/' + taskId,
                        type: 'POST',
                        data: putData,
                        processData: false,
                        contentType: false,
                        success: (response) => {
                            if (response.success) {
                                showToast('success', 'تم تحديث Sprint للمهمة');
                                // Reload the current tab
                                const activeTab = $('.tab-pane.active').attr('id');
                                loadTabContent(activeTab);
                            }
                        },
                        error: () => {
                            showToast('error', 'حدث خطأ أثناء تحديث Sprint');
                        }
                    });
                }
            }
        }
    });
}

// Function to create a new sprint and assign it to a task
function createAndAssignSprint(taskId, name, goal, startDate, endDate, applyToChildren) {
    // Show loading message
    Swal.fire({
        title: 'جاري إنشاء Sprint...',
        allowOutsideClick: false,
        didOpen: () => {
            Swal.showLoading();
        }
    });

    // Get the project ID from the task (we need to fetch the task first)
    $.get('/tasks/' + taskId, (taskResponse) => {
        if (taskResponse.success && taskResponse.task.project_id) {
            // Create the new sprint
            const sprintData = new FormData();
            sprintData.append('_token', $('meta[name="csrf-token"]').attr('content'));
            sprintData.append('project_id', taskResponse.task.project_id);
            sprintData.append('name', name);
            if (goal) sprintData.append('goal', goal);
            if (startDate) sprintData.append('start_date', startDate);
            if (endDate) sprintData.append('end_date', endDate);
            // Set default status to planned
            sprintData.append('status', 'planned');

            $.ajax({
                url: route('sprints.store'),
                type: 'POST',
                data: sprintData,
                processData: false,
                contentType: false,
                success: (response) => {
                    if (response.success && response.sprint) {
                        // Add the new sprint to all sprint dropdowns
                        const newOption = new Option(response.sprint.name, response.sprint.id, true, true);

                        $('#componentFilterSprint').append(newOption.cloneNode(true));
                        $('#epicFilterSprint').append(newOption.cloneNode(true));
                        $('#storyFilterSprint').append(newOption.cloneNode(true));
                        $('#subtaskFilterSprint').append(newOption.cloneNode(true));
                        $('#bugFilterSprint').append(newOption.cloneNode(true));

                        // Now assign this sprint to the task
                        const formData = new FormData();
                        formData.append('_token', $('meta[name="csrf-token"]').attr('content'));
                        formData.append('sprint_id', response.sprint.id);

                        if (applyToChildren) {
                            // Use route helper for updating children sprint - POST method
                            $.ajax({
                                url: route('tasks.update-children-sprint', { taskId: taskId }),
                                type: 'POST',
                                data: formData,
                                processData: false,
                                contentType: false,
                                success: (response) => {
                                    if (response.success) {
                                        Swal.fire('نجاح', 'تم إنشاء Sprint وتعيينه لجميع العناصر الفرعية', 'success');
                                        // Reload the current tab
                                        const activeTab = $('.tab-pane.active').attr('id');
                                        loadTabContent(activeTab);
                                    } else {
                                        Swal.fire('خطأ', response.message || 'حدث خطأ أثناء تحديث العناصر الفرعية', 'error');
                                        // Still reload the current tab
                                        const activeTab = $('.tab-pane.active').attr('id');
                                        loadTabContent(activeTab);
                                    }
                                },
                                error: (xhr) => {
                                    Swal.fire('خطأ', 'حدث خطأ أثناء تحديث العناصر الفرعية: ' + (xhr.responseJSON?.message || 'خطأ غير معروف'), 'error');
                                    // Still reload the current tab
                                    const activeTab = $('.tab-pane.active').attr('id');
                                    loadTabContent(activeTab);
                                }
                            });
                        } else {
                            // Update only the current task - PUT method
                            const putData = new FormData();
                            putData.append('_token', $('meta[name="csrf-token"]').attr('content'));
                            putData.append('_method', 'PUT');
                            putData.append('sprint_id', response.sprint.id);

                            $.ajax({
                                url: '/tasks/' + taskId,
                                type: 'POST',
                                data: putData,
                                processData: false,
                                contentType: false,
                                success: (response) => {
                                    if (response.success) {
                                        Swal.fire('نجاح', 'تم إنشاء Sprint وتعيينه للمهمة', 'success');
                                        // Reload the current tab
                                        const activeTab = $('.tab-pane.active').attr('id');
                                        loadTabContent(activeTab);
                                    }
                                },
                                error: () => {
                                    Swal.fire('خطأ', 'حدث خطأ أثناء تحديث Sprint', 'error');
                                }
                            });
                        }
                    } else {
                        Swal.fire('خطأ', response.message || 'حدث خطأ أثناء إنشاء Sprint', 'error');
                    }
                },
                error: (xhr) => {
                    Swal.fire('خطأ', 'حدث خطأ أثناء إنشاء Sprint: ' + (xhr.responseJSON?.message || 'خطأ غير معروف'), 'error');
                }
            });
        } else {
            Swal.fire('خطأ', 'تعذر الحصول على معلومات المشروع للمهمة', 'error');
        }
    }).fail(() => {
        Swal.fire('خطأ', 'تعذر الحصول على معلومات المهمة', 'error');
    });
}

// Function to recursively update child tasks with the same sprint
function updateChildTasksSprint(parentTaskId, sprintId) {
    // Show loading message
    Swal.fire({
        title: 'جاري تحديث العناصر الفرعية...',
        allowOutsideClick: false,
        didOpen: () => {
            Swal.showLoading();
        }
    });

    // Call the backend to update all child tasks using route helper - POST method
    const formData = new FormData();
    formData.append('_token', $('meta[name="csrf-token"]').attr('content'));
    if (sprintId) {
        formData.append('sprint_id', sprintId);
    }

    $.ajax({
        url: route('tasks.update-children-sprint', { taskId: parentTaskId }),
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: (response) => {
            if (response.success) {
                Swal.fire('نجاح', 'تم تحديث Sprint لجميع العناصر الفرعية', 'success');
                // Reload the current tab
                const activeTab = $('.tab-pane.active').attr('id');
                loadTabContent(activeTab);
            } else {
                Swal.fire('خطأ', response.message || 'حدث خطأ أثناء تحديث العناصر الفرعية', 'error');
                // Still reload the current tab
                const activeTab = $('.tab-pane.active').attr('id');
                loadTabContent(activeTab);
            }
        },
        error: (xhr) => {
            Swal.fire('خطأ', 'حدث خطأ أثناء تحديث العناصر الفرعية: ' + (xhr.responseJSON?.message || 'خطأ غير معروف'), 'error');
            // Still reload the current tab
            const activeTab = $('.tab-pane.active').attr('id');
            loadTabContent(activeTab);
        }
    });
}



// إضافة هذه الدوال إلى ملف product-backlog.js

// دالة لتحميل Backlog مع Sprints القابلة للطي
function loadBacklogWithSprints() {
    showSkeletonLoader('#backlogContent');

    // Get filter values
    var backlogFilters = {
        sprint_id: $('#backlogFilterSprint').val(),
        user_id: $('#backlogFilterUser').val(),
        priority: $('#backlogFilterPriority').val(),
        status: $('#backlogFilterStatus').val()
    };

    $.ajax({
        url: '/api/backlog/sprints-and-tasks',
        method: 'GET',
        data: backlogFilters,
        cache: false,
        success: (response) => {
            if (response.success) {
                renderBacklogAccordion(response.sprints, response.backlogTasks);
            } else {
                showError('#backlogContent', 'Backlog');
            }
        },
        error: () => showError('#backlogContent', 'Backlog')
    });
}

// دالة لعرض Accordion الخاص بـ Backlog
function renderBacklogAccordion(sprints, backlogTasks) {
    let html = '<div class="accordion" id="backlogAccordion">';

    // قسم المهام غير المجدولة (Backlog)
    html += `
        <div class="card">
            <div class="card-header bg-secondary" id="headingBacklog">
                <h2 class="mb-0">
                    <button class="btn btn-link btn-block text-right text-white collapsed" type="button"
                            data-toggle="collapse" data-target="#collapseBacklog"
                            aria-expanded="false" aria-controls="collapseBacklog">
                        <i class="feather icon-inbox"></i>
                        <strong>Backlog - مهام غير مجدولة</strong>
                        <span class="badge badge-light float-left">${backlogTasks.length} مهمة</span>
                        <i class="feather icon-chevron-down float-left mr-2"></i>
                    </button>
                </h2>
            </div>
            <div id="collapseBacklog" class="collapse" aria-labelledby="headingBacklog" data-parent="#backlogAccordion">
                <div class="card-body">
                    ${renderBacklogTasksList(backlogTasks)}
                </div>
            </div>
        </div>
    `;

    // Sprints المجدولة
    sprints.forEach((sprint, index) => {
        const sprintId = `sprint${sprint.id}`;
        const isExpanded = index === 0 ? 'show' : '';
        const ariaExpanded = index === 0 ? 'true' : 'false';
        const collapsed = index === 0 ? '' : 'collapsed';

        const statusBadge = getSprintStatusBadge(sprint.status);
        const dateRange = sprint.start_date && sprint.end_date
            ? `${formatDate(sprint.start_date)} - ${formatDate(sprint.end_date)}`
            : 'غير محدد';

        html += `
            <div class="card">
                <div class="card-header ${getSprintHeaderClass(sprint.status)}" id="heading${sprintId}">
                    <h2 class="mb-0">
                        <button class="btn btn-link btn-block text-right ${collapsed}" type="button"
                                data-toggle="collapse" data-target="#collapse${sprintId}"
                                aria-expanded="${ariaExpanded}" aria-controls="collapse${sprintId}">
                            <i class="feather icon-calendar"></i>
                            <strong>${sprint.name}</strong>
                            ${statusBadge}
                            <span class="badge badge-info float-left">${sprint.tasks_count || 0} مهمة</span>
                            <i class="feather icon-chevron-down float-left mr-2"></i>
                            <br>
                            <small class="text-muted">${dateRange}</small>
                            ${sprint.goal ? `<br><small class="text-muted"><i class="feather icon-target"></i> ${sprint.goal}</small>` : ''}
                        </button>
                    </h2>
                </div>
                <div id="collapse${sprintId}" class="collapse ${isExpanded}"
                     aria-labelledby="heading${sprintId}" data-parent="#backlogAccordion">
                    <div class="card-body">
                        ${renderSprintTasksHierarchy(sprint.tasks)}
                    </div>
                </div>
            </div>
        `;
    });

    html += '</div>';
    $('#backlogContent').html(html);
}

// دالة لعرض المهام غير المجدولة
function renderBacklogTasksList(tasks) {
    if (!tasks || tasks.length === 0) {
        return `<div class="alert alert-info">
            <i class="feather icon-info"></i> لا توجد مهام في Backlog حالياً
        </div>`;
    }

    // تصنيف المهام حسب النوع
    const groupedTasks = {
        component: tasks.filter(t => t.type === 'component'),
        epic: tasks.filter(t => t.type === 'epic'),
        user_story: tasks.filter(t => t.type === 'user_story'),
        sub_task: tasks.filter(t => t.type === 'sub_task'),
        bug: tasks.filter(t => t.type === 'bug')
    };

    let html = '<div class="backlog-tasks">';

    // Components
    if (groupedTasks.component.length > 0) {
        html += '<h5 class="mt-3"><i class="feather icon-package"></i> Components</h5>';
        html += renderTaskCards(groupedTasks.component, 'component');
    }

    // Epics
    if (groupedTasks.epic.length > 0) {
        html += '<h5 class="mt-3"><i class="feather icon-layers"></i> Epics</h5>';
        html += renderTaskCards(groupedTasks.epic, 'epic');
    }

    // User Stories
    if (groupedTasks.user_story.length > 0) {
        html += '<h5 class="mt-3"><i class="feather icon-file-text"></i> User Stories</h5>';
        html += renderTaskCards(groupedTasks.user_story, 'user_story');
    }

    // Sub Tasks
    if (groupedTasks.sub_task.length > 0) {
        html += '<h5 class="mt-3"><i class="feather icon-list"></i> Sub Tasks</h5>';
        html += renderTaskCards(groupedTasks.sub_task, 'sub_task');
    }

    // Bugs
    if (groupedTasks.bug.length > 0) {
        html += '<h5 class="mt-3"><i class="feather icon-alert-triangle"></i> Bugs</h5>';
        html += renderTaskCards(groupedTasks.bug, 'bug');
    }

    html += '</div>';
    return html;
}

// دالة لعرض المهام في Sprint بشكل هرمي
function renderSprintTasksHierarchy(tasks) {
    if (!tasks || tasks.length === 0) {
        return `<div class="alert alert-info">
            <i class="feather icon-info"></i> لا توجد مهام في هذا Sprint
        </div>`;
    }

    // تنظيم المهام بشكل هرمي
    const components = tasks.filter(t => t.type === 'component');
    const epics = tasks.filter(t => t.type === 'epic');
    const stories = tasks.filter(t => t.type === 'user_story');
    const subtasks = tasks.filter(t => t.type === 'sub_task');
    const bugs = tasks.filter(t => t.type === 'bug');

    let html = '<div class="sprint-tasks-hierarchy">';

    // عرض Components مع Epics التابعة لها
    components.forEach(component => {
        html += `<div class="task-card component-card mb-3">
            <div class="card">
                <div class="card-header bg-light">
                    <h5>
                        <i class="feather icon-package text-primary"></i>
                        ${component.title}
                        ${getPriorityBadge(component.priority)}
                        ${getStatusBadge(component.status)}
                    </h5>
                    <p class="mb-0 text-muted">${component.description || ''}</p>
                    <div class="mt-2">
                        <button class="btn btn-sm btn-outline-primary" onclick="editComponent(${component.id})">
                            <i class="feather icon-edit"></i> تعديل
                        </button>
                        <button class="btn btn-sm btn-outline-danger" onclick="deleteComponent(${component.id})">
                            <i class="feather icon-trash"></i> حذف
                        </button>
                    </div>
                </div>
                <div class="card-body">
        `;

        // Epics التابعة لهذا Component
        const componentEpics = epics.filter(e => e.parent_task_id === component.id);
        if (componentEpics.length > 0) {
            componentEpics.forEach(epic => {
                html += renderEpicWithChildren(epic, stories, subtasks, bugs);
            });
        } else {
            html += '<p class="text-muted mb-0"><em>لا توجد Epics لهذا Component</em></p>';
        }

        html += `
                </div>
            </div>
        </div>`;
    });

    // Epics بدون Component
    const orphanEpics = epics.filter(e => !e.parent_task_id);
    if (orphanEpics.length > 0) {
        html += '<h5 class="mt-3">Epics بدون Component:</h5>';
        orphanEpics.forEach(epic => {
            html += renderEpicWithChildren(epic, stories, subtasks, bugs);
        });
    }

    // Stories بدون Epic
    const orphanStories = stories.filter(s => !s.parent_task_id);
    if (orphanStories.length > 0) {
        html += '<h5 class="mt-3">User Stories بدون Epic:</h5>';
        orphanStories.forEach(story => {
            html += renderStoryWithSubtasks(story, subtasks);
        });
    }

    // Bugs بدون Epic
    const orphanBugs = bugs.filter(b => !b.parent_task_id);
    if (orphanBugs.length > 0) {
        html += '<h5 class="mt-3">Bugs بدون Epic:</h5>';
        html += renderTaskCards(orphanBugs, 'bug');
    }

    html += '</div>';
    return html;
}

// دالة لعرض Epic مع العناصر التابعة له
function renderEpicWithChildren(epic, allStories, allSubtasks, allBugs) {
    const epicStories = allStories.filter(s => s.parent_task_id === epic.id);
    const epicBugs = allBugs.filter(b => b.parent_task_id === epic.id);

    let html = `
        <div class="task-card epic-card mb-3 ml-3">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h6>
                        <i class="feather icon-layers"></i>
                        ${epic.title}
                        ${getPriorityBadge(epic.priority)}
                        ${getStatusBadge(epic.status)}
                    </h6>
                    <p class="mb-0"><small>${epic.description || ''}</small></p>
                    <div class="mt-2">
                        <button class="btn btn-sm btn-outline-light" onclick="editEpic(${epic.id})">
                            <i class="feather icon-edit"></i> تعديل
                        </button>
                        <button class="btn btn-sm btn-outline-light" onclick="deleteEpic(${epic.id})">
                            <i class="feather icon-trash"></i> حذف
                        </button>
                    </div>
                </div>
                <div class="card-body">
    `;

    // User Stories
    if (epicStories.length > 0) {
        epicStories.forEach(story => {
            html += renderStoryWithSubtasks(story, allSubtasks);
        });
    }

    // Bugs
    if (epicBugs.length > 0) {
        html += '<div class="mt-2"><strong>Bugs:</strong></div>';
        html += renderTaskCards(epicBugs, 'bug');
    }

    if (epicStories.length === 0 && epicBugs.length === 0) {
        html += '<p class="text-muted mb-0"><em>لا توجد User Stories أو Bugs لهذا Epic</em></p>';
    }

    html += `
                </div>
            </div>
        </div>
    `;

    return html;
}

// دالة لعرض Story مع Sub Tasks
function renderStoryWithSubtasks(story, allSubtasks) {
    const storySubtasks = allSubtasks.filter(st => st.parent_task_id === story.id);

    let html = `
        <div class="task-card story-card mb-2 ml-4">
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <strong>
                        <i class="feather icon-file-text"></i>
                        ${story.title}
                    </strong>
                    ${getPriorityBadge(story.priority)}
                    ${getStatusBadge(story.status)}
                    <span class="badge badge-light float-left">${story.completion_percentage || 0}%</span>
                    <div class="mt-2">
                        <button class="btn btn-sm btn-outline-light" onclick="editStory(${story.id})">
                            <i class="feather icon-edit"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-light" onclick="deleteStory(${story.id})">
                            <i class="feather icon-trash"></i>
                        </button>
                    </div>
                </div>
    `;

    if (storySubtasks.length > 0) {
        html += '<div class="card-body">';
        storySubtasks.forEach(subtask => {
            html += `
                <div class="task-item mb-1 p-2 border-left border-info">
                    <i class="feather icon-check-square"></i>
                    ${subtask.title}
                    ${getPriorityBadge(subtask.priority)}
                    ${getStatusBadge(subtask.status)}
                    <span class="badge badge-secondary">${subtask.completion_percentage || 0}%</span>
                    <button class="btn btn-sm btn-link" onclick="editSubTask(${subtask.id})">
                        <i class="feather icon-edit"></i>
                    </button>
                </div>
            `;
        });
        html += '</div>';
    }

    html += '</div></div>';
    return html;
}

// دالة لعرض بطاقات المهام
function renderTaskCards(tasks, type) {
    let html = '<div class="row">';

    tasks.forEach(task => {
        html += `
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="card task-card-item">
                    <div class="card-body">
                        <h6>${task.title}</h6>
                        <p class="text-muted small">${task.description ? task.description.substring(0, 100) : ''}</p>
                        <div class="d-flex justify-content-between align-items-center">
                            ${getPriorityBadge(task.priority)}
                            ${getStatusBadge(task.status)}
                        </div>
                        ${task.completion_percentage !== undefined ?
                            `<div class="progress mt-2" style="height: 5px;">
                                <div class="progress-bar" style="width: ${task.completion_percentage}%"></div>
                            </div>` : ''}
                        <div class="mt-2">
                            <button class="btn btn-sm btn-primary" onclick="window.assignSprintToTask(${task.id}, '${type}')">
                                <i class="feather icon-calendar"></i> تعيين Sprint
                            </button>
                            <button class="btn btn-sm btn-outline-primary" onclick="edit${capitalizeFirst(type)}(${task.id})">
                                <i class="feather icon-edit"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        `;
    });

    html += '</div>';
    return html;
}

// دالة لعرض المهام غير المجدولة في شكل جدول
function renderBacklogTasksTable(tasks) {
    if (!tasks || tasks.length === 0) {
        return `<div class="alert alert-info">
            <i class="feather icon-info"></i> لا توجد مهام في Backlog حالياً
        </div>`;
    }

    let html = `<div class="table-responsive"><table class="table table-striped table-bordered">
        <thead><tr>
            <th>العنوان</th>
            <th>النوع</th>
            <th>الأولوية</th>
            <th>الحالة</th>
            <th>المستخدمون</th>
            <th>الإجراءات</th>
        </tr></thead><tbody>`;

    tasks.forEach(task => {
        const taskType = getTaskTypeBadge(task.type);
        
        html += `<tr>
            <td>${task.title}</td>
            <td>${taskType}</td>
            <td>${getPriorityBadge(task.priority)}</td>
            <td>${getStatusBadge(task.status)}</td>
            <td>${getUsersBadges(task.assigned_users)}</td>
            <td>
                <button class="btn btn-sm btn-primary" onclick="window.assignSprintToTask(${task.id}, '${task.type}')" title="تعيين Sprint">
                    <i class="feather icon-calendar"></i>
                </button>
                <button class="btn btn-sm btn-light" onclick="editTaskByType(${task.id}, '${task.type}')" title="تعديل">
                    <i class="feather icon-edit"></i>
                </button>
                <button class="btn btn-sm btn-danger" onclick="deleteTaskByType(${task.id}, '${task.type}')" title="حذف">
                    <i class="feather icon-trash"></i>
                </button>
            </td>
        </tr>`;
    });

    html += `</tbody></table></div>`;
    return html;
}

