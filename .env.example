# اتركها فارغةً هنا واضبطها من: الإعدادات <- البريد (SMTP).
# ما يُحفَظ في تلك الشاشة (جدول smtp_settings) يتقدّم على هذه القيم؛
# ولا يُرجَع إلى .env إلا حين تكون الشاشة فارغة.
#
# كانت هنا بياناتُ حسابٍ حقيقي بكلمة مرورها، فكان كلُّ تثبيتٍ جديد
# ينسخ الملفَّ ويُحاول المصادقةَ بحسابٍ ليس له — فيردّ الخادم
# «535 authentication failed» على أول بريدٍ يخرج من النظام.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1


GOOGLE_MAPS_API_KEY=AIzaSyDt-smE9xetrBzDcOhHRgmZMdrt10kdhNM
VITE_APP_NAME="${APP_NAME}"

# === Firebase Cloud Messaging (FCM) — إشعارات النقاط ===
# ضع مفتاح السيرفر من Firebase Console > Project Settings > Cloud Messaging
FIREBASE_SERVER_KEY=

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
