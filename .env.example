APP_TIMEZONE=Asia/Riyadh
FAWTRA_BASE_URL=https://dashboard.fawtrasmart.com
FAWTRA_CLIENT_ID=
FAWTRA_SECRET=
FAWTRA_DOMAIN=
# في التطوير المحلي بلا لوحة فوترة: false. في الإنتاج اتركها true أو احذف السطر.
FAWTRA_ENFORCE_SUBSCRIPTION=true
# عطّلهما إن كانت هذه القاعدة تجريبية وتشترك في مفتاح إنتاج.
FAWTRA_USAGE_REPORT=true
FAWTRA_USAGE_PUSH_ON_WRITE=true

# Shared secret with the mobile API (Node) for uploading app photos into public/ — same value as ERP_MEDIA_TOKEN there. Empty = disabled.
